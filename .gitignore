# --- EDF recordings — never versioned ---
*.edf
*.bdf
# The one exception, and it is deliberate: the recording the report for the
# Sourcebook article is written from. A paper that describes what the
# software measures has to ship the file it measured, or the numbers cannot
# be checked. It is one recording of 140 s, 611 kB.
!docs/informe-sourcebook/*.edf

# --- Local data files ---
data/
local/
salida/
output/
*.csv
# Igual que el EDF: la exportación CSV que el informe cita como adjunto.
!docs/informe-sourcebook/*.csv
*.npy
*.npz
!tests/**/*.npy
!tests/**/*.npz

# --- Documentation builds ---
site/
docs/_build/
# generated PDFs (artifacts); the .md files are the versioned source
docs/*.pdf

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- Secrets / personal config ---
.env
.env.*
!.env.example
secrets.toml

